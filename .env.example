# Public application origin. Change this when the Hostinger domain is connected.
NEXT_PUBLIC_SITE_URL=https://example.com

# Website booking stays paused by default. Set true only after activation testing, then rebuild.
NEXT_PUBLIC_WEBSITE_BOOKING_ENABLED=false

# Supabase public client configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy key used by server-side integrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key required for administrator user-management endpoints.
SUPABASE_SERVICE_ROLE_KEY=
